---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import type { MarkdownHeading } from "astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	landing?: boolean;
}

const { title, description, lang, setOGTypeArticle, headings = [], landing = false } = Astro.props;
const showToc = siteConfig.toc.enable && headings.length > 0;
---

<Layout title={title} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>
	<slot name="head" slot="head" />
	<a class="skip-link" href="#swup-container">跳到正文</a>
	<Navbar />
	<main id="swup-container" class:list={["site-main transition-swup-fade", landing ? "site-landing" : "site-shell", { "site-reader": showToc }]} tabindex="-1">
		<div class="site-main-content"><slot /></div>
		{showToc && (
			<aside class="reader-toc" aria-label="文章目录">
				<p>本文目录</p>
				<div id="toc-inner-wrapper">
					<div id="toc"><TOC headings={headings} /></div>
				</div>
			</aside>
		)}
	</main>
	<Footer />
	<BackToTop />
</Layout>

<style>
	.skip-link {
		position: fixed;
		top: 0.5rem;
		left: 0.5rem;
		z-index: 100;
		transform: translateY(calc(-100% - 1rem));
		border-radius: 0.5rem;
		background: var(--card-bg);
		padding: 0.6rem 1rem;
	}
	.skip-link:focus { transform: none; }
	.site-main-content { min-width: 0; }
	.site-reader { max-width: 65rem; }
	.reader-toc { display: none; }

	@media (min-width: 960px) {
		.site-reader {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 14rem;
			gap: clamp(1.5rem, 4vw, 3rem);
		}
		.reader-toc { display: block; position: sticky; top: 2rem; align-self: start; min-width: 0; }
		.reader-toc p { font-size: 0.875rem; font-weight: 700; margin: 0.35rem 0 0.55rem 0.5rem; }
		#toc-inner-wrapper { max-height: calc(100vh - 5rem); overflow-y: auto; mask-image: none; }
		#toc { display: block; position: relative; }
	}
</style>
