---
import "@fontsource/roboto/400.css";
import "@fontsource/roboto/500.css";
import "@fontsource/roboto/700.css";
import "@fontsource-variable/jetbrains-mono";
import "katex/dist/katex.css";

import ConfigCarrier from "@components/ConfigCarrier.astro";
import { ownerConfig, profileConfig, siteConfig } from "@/config";
import { AUTO_MODE, DARK_MODE, DEFAULT_THEME } from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import "../styles/variables.styl";
import "../styles/main.css";
import "../styles/markdown.css";
import "../styles/markdown-extend.styl";
import "../styles/scrollbar.css";
import "../styles/transition.css";
import "../styles/photoswipe.css";
import "../styles/expressive-code.css";
import "../styles/site.css";
import { url } from "../utils/url-utils";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
}

const { title, description = siteConfig.subtitle, lang, setOGTypeArticle } = Astro.props;
const pageTitle = title ? `${title} - ${siteConfig.title}` : siteConfig.title;
const canonicalUrl = Astro.url.href;
const rssUrl = new URL(url("rss.xml"), ownerConfig.siteOrigin).href;
const siteLang = (lang || siteConfig.lang).replace("_", "-");
const configHue = siteConfig.themeColor.hue;
const favicons = siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;
const personJsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: profileConfig.name,
	alternateName: ownerConfig.handle,
	url: ownerConfig.siteUrl,
	image: ownerConfig.avatarUrl,
	sameAs: [ownerConfig.githubUrl],
};
---

<!DOCTYPE html>
<html lang={siteLang} data-overlayscrollbars-initialize>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content={`${profileConfig.name} (@${ownerConfig.handle})`} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="author" href={ownerConfig.githubUrl} />
		<link rel="me" href={ownerConfig.githubUrl} />
		<link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={rssUrl} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)}></script>

		<meta property="og:site_name" content={siteConfig.title} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={setOGTypeArticle ? "article" : "website"} />
		<meta property="profile:username" content={ownerConfig.handle} />
		<meta name="twitter:card" content="summary" />

		{favicons.map((favicon) => (
			<link rel="icon"
				href={favicon.src.startsWith("/") ? url(favicon.src) : favicon.src}
				sizes={favicon.sizes}
				media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<script is:inline define:vars={{ AUTO_MODE, DARK_MODE, DEFAULT_THEME, configHue }}>
			const mode = localStorage.getItem("theme") || DEFAULT_THEME;
			const dark = mode === DARK_MODE || (mode === AUTO_MODE && matchMedia("(prefers-color-scheme: dark)").matches);
			document.documentElement.classList.toggle("dark", dark);
			document.documentElement.style.setProperty("--hue", localStorage.getItem("hue") || configHue);
		</script>
		<slot name="head" />
	</head>
	<body data-overlayscrollbars-initialize>
		<ConfigCarrier />
		<slot />
	</body>
</html>

<script>
	import { OverlayScrollbars } from "overlayscrollbars";
	import "overlayscrollbars/overlayscrollbars.css";
	import PhotoSwipeLightbox from "photoswipe/lightbox";
	import "photoswipe/style.css";

	OverlayScrollbars({ target: document.body, cancel: { nativeScrollbarsOverlaid: true } }, {
		scrollbars: { theme: "scrollbar-base scrollbar-auto py-1", autoHide: "move", autoHideDelay: 500 },
	});

	function initMathScroll() {
		for (const formula of document.querySelectorAll<HTMLElement>(".katex-display")) {
			if (formula.closest(".katex-display-container")) continue;
			const container = document.createElement("div");
			container.className = "katex-display-container";
			container.setAttribute("aria-label", "可横向滚动的数学公式");
			formula.before(container);
			container.append(formula);
			OverlayScrollbars(container, {
				scrollbars: { theme: "scrollbar-base scrollbar-auto", autoHide: "leave" },
			});
		}
	}

	function createPhotoSwipe() {
		const lightbox = new PhotoSwipeLightbox({
			gallery: ".custom-md img, #post-cover img",
			pswpModule: () => import("photoswipe"),
			wheelToZoom: true,
			arrowPrev: false,
			arrowNext: false,
			imageClickAction: "close",
			tapAction: "close",
			doubleTapAction: "zoom",
		});
		lightbox.addFilter("domItemData", (itemData, element) => {
			if (element instanceof HTMLImageElement) {
				itemData.src = element.currentSrc || element.src;
				itemData.w = element.naturalWidth || window.innerWidth;
				itemData.h = element.naturalHeight || window.innerHeight;
				itemData.msrc = itemData.src;
			}
			return itemData;
		});
		lightbox.init();
		return lightbox;
	}

	initMathScroll();
	let lightbox = createPhotoSwipe();

	function attachNavigation() {
		window.swup.hooks.on("content:replace", () => { lightbox.destroy(); }, { before: true });
		window.swup.hooks.on("page:view", () => {
			initMathScroll();
			lightbox = createPhotoSwipe();
		});
	}
	if (window.swup) attachNavigation();
	else document.addEventListener("swup:enable", attachNavigation, { once: true });
</script>
