---
import { Icon } from "astro-icon/components";
---

<button id="back-to-top-btn" class="back-to-top" type="button" aria-label="返回顶部" hidden>
	<Icon name="fa6-solid:arrow-up" aria-hidden="true" />
</button>

<style>
	.back-to-top {
		position: fixed;
		right: 1.25rem;
		bottom: 1.25rem;
		z-index: 20;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--site-border);
		border-radius: 0.8rem;
		background: var(--card-bg);
		color: var(--primary);
	}
	.back-to-top[hidden] { display: none; }
	.back-to-top:hover { background: var(--site-hover); }
</style>

<script>
	const button = document.querySelector<HTMLButtonElement>("#back-to-top-btn");
	if (button) {
		const update = () => { button.hidden = window.scrollY < 640; };
		window.addEventListener("scroll", update, { passive: true });
		button.addEventListener("click", () => {
			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			window.scrollTo({ top: 0, behavior: reduceMotion ? "instant" : "smooth" });
		});
		update();
	}
</script>
