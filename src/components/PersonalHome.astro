---
import { Icon } from "astro-icon/components";
import { ownerConfig } from "../config";
import { url } from "../utils/url-utils";

const stats = [
	{ value: "24", label: "合并上游 PR" },
	{ value: "18", label: "上游仓库" },
	{ value: "3", label: "维护项目" },
];

const projects = [
	{
		name: "MindNotes Pro",
		description:
			"本地优先的 React / Canvas 白板，专注离线写画、隐私、浏览器可用性和可读实现。",
		stack: ["TypeScript", "React", "Canvas", "offline-first"],
		href: "https://github.com/11suixing11/mindnotes-pro",
		demo: "https://11suixing11.github.io/mindnotes-pro/",
		icon: "fa6-solid:pen-ruler",
	},
	{
		name: "Athena",
		description:
			"自托管日记与归档应用，把笔记、附件和个人记录留在自己控制的服务器上。",
		stack: ["TypeScript", "Go", "self-hosted", "PWA"],
		href: "https://github.com/11suixing11/athena",
		icon: "fa6-solid:server",
	},
	{
		name: "OSS Maintenance",
		description:
			"在真实阅读过的项目里提交小而可审查的修复，覆盖可访问性、测试、CI 与类型边界。",
		stack: ["TypeScript", "testing", "a11y", "CI"],
		href: "https://github.com/11suixing11?tab=repositories",
		icon: "fa6-solid:screwdriver-wrench",
	},
];

const upstreamWork = [
	{
		project: "kulcsarrudolf/zimme-zoom",
		title: "Guard bundle size and tree shaking",
		description:
			"为公开入口和 Image-only 导入路径补充体积预算，并完成 Node 20 兼容与文档清理。",
		href: "https://github.com/kulcsarrudolf/zimme-zoom/pull/43",
	},
	{
		project: "kulcsarrudolf/zimme-zoom",
		title: "Harden PhotoViewer portal accessibility",
		description:
			"将查看器移入 body portal，打开时隐藏背景内容，并在关闭后安全恢复焦点。",
		href: "https://github.com/kulcsarrudolf/zimme-zoom/pull/47",
	},
	{
		project: "plait-board/drawnix",
		title: "Fix middle-mouse panning in freehand tools",
		description:
			"让自由绘制工具激活时仍可使用中键平移，并经过两轮维护者评审打磨交互覆盖。",
		href: "https://github.com/plait-board/drawnix/pull/449",
	},
	{
		project: "mdx-editor/editor",
		title: "Respect configured heading shortcuts",
		description:
			"把标题层级发布移入插件初始化，使 Markdown 快捷键从首帧起就遵守配置。",
		href: "https://github.com/mdx-editor/editor/pull/952",
	},
];
---

<section id="profile" class="flex flex-col gap-5 mb-7 onload-animation">
	<div class="card-base relative overflow-hidden px-6 py-6 md:px-8 md:py-8">
		<div class="flex flex-col gap-6">
			<div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5">
				<div class="max-w-3xl">
					<div class="mb-3 text-xs font-bold text-[var(--primary)]">
						OPEN-SOURCE MAINTAINER
					</div>
					<h1 class="text-3xl md:text-[2.6rem]/[3rem] font-bold text-90 mb-3">
						kittydev / {ownerConfig.handle}
					</h1>
					<p class="text-75 leading-7">
						TypeScript · React · Canvas · upstream maintenance。专注于可复现的问题、窄而完整的修复，以及能经得住后续维护的 UI 实现。
					</p>
				</div>

				<div class="flex flex-wrap gap-2 shrink-0">
					<a
						href={ownerConfig.githubUrl}
						target="_blank"
						rel="me noopener"
						class="btn-regular h-10 rounded-lg px-4 gap-2 font-bold active:scale-95"
					>
						<Icon name="fa6-brands:github" class="text-xl"></Icon>
						GitHub
					</a>
					<a
						href="https://github.com/11suixing11/11suixing11"
						target="_blank"
						class="btn-plain h-10 rounded-lg px-4 gap-2 font-bold active:scale-95"
					>
						个人资料 README
						<Icon name="fa6-solid:arrow-up-right-from-square" class="text-xs opacity-50"></Icon>
					</a>
				</div>
			</div>

			<div class="grid grid-cols-3 gap-3 pt-5 border-t border-dashed border-black/10 dark:border-white/15">
				{
					stats.map((item) => (
						<div class="min-w-0">
							<div class="text-2xl md:text-3xl font-bold text-[var(--primary)]">
								{item.value}
							</div>
							<div class="text-xs md:text-sm text-50 truncate">{item.label}</div>
						</div>
					))
				}
			</div>
		</div>
	</div>

	<div id="projects">
		<div class="flex items-end justify-between gap-4 mb-3">
			<div>
				<div class="text-xs font-bold text-[var(--primary)] mb-1">MAINTAINED</div>
				<h2 class="text-xl font-bold text-90">维护中的项目</h2>
			</div>
			<a
				href="https://github.com/11suixing11?tab=repositories"
				target="_blank"
				class="text-sm font-bold text-[var(--primary)] whitespace-nowrap"
			>
				全部仓库
			</a>
		</div>

		<div class="grid md:grid-cols-3 gap-4">
			{
				projects.map((project) => (
					<article class="card-base p-5 min-h-[14rem] flex flex-col">
						<div class="w-10 h-10 rounded-xl bg-[var(--primary)] text-white flex items-center justify-center mb-4">
							<Icon name={project.icon} class="text-xl"></Icon>
						</div>
						<h3 class="text-lg font-bold text-90 mb-2">{project.name}</h3>
						<p class="text-sm text-75 leading-6 flex-1">{project.description}</p>
						<div class="flex flex-wrap gap-1.5 mt-4">
							{project.stack.map((item) => (
								<span class="text-[0.7rem] font-bold px-2 py-1 rounded-md bg-black/5 dark:bg-white/10 text-50">
									{item}
								</span>
							))}
						</div>
						<div class="flex items-center gap-3 mt-4 pt-3 border-t border-dashed border-black/10 dark:border-white/15">
							<a href={project.href} target="_blank" class="text-sm font-bold text-[var(--primary)]">
								Repository
							</a>
							{
								project.demo && (
									<a href={project.demo} target="_blank" class="text-sm font-bold text-50 hover:text-[var(--primary)]">
										Live demo
									</a>
								)
							}
						</div>
					</article>
				))
			}
		</div>
	</div>

	<div id="upstream">
		<div class="flex items-end justify-between gap-4 mb-3">
			<div>
				<div class="text-xs font-bold text-[var(--primary)] mb-1">MERGED UPSTREAM</div>
				<h2 class="text-xl font-bold text-90">精选上游贡献</h2>
			</div>
			<a
				href="https://github.com/11suixing11?tab=repositories"
				target="_blank"
				class="text-sm font-bold text-[var(--primary)] whitespace-nowrap"
			>
				查看全部
			</a>
		</div>

		<div class="grid md:grid-cols-2 gap-4">
			{
				upstreamWork.map((item) => (
					<a
						href={item.href}
						target="_blank"
						class="card-base p-5 group active:scale-[0.99]"
					>
						<div class="flex items-center gap-2 text-xs font-bold text-50 mb-3">
							<Icon name="fa6-solid:code-pull-request" class="text-[var(--primary)]"></Icon>
							{item.project}
						</div>
						<h3 class="text-base font-bold text-90 group-hover:text-[var(--primary)] mb-2">
							{item.title}
						</h3>
						<p class="text-sm text-75 leading-6">{item.description}</p>
					</a>
				))
			}
		</div>
	</div>

	<div id="notes">
		<div class="mb-3">
			<div class="text-xs font-bold text-[var(--primary)] mb-1">NOTES</div>
			<h2 class="text-xl font-bold text-90">工程笔记</h2>
		</div>

		<div class="grid md:grid-cols-2 gap-4">
			<a href={url("/posts/mindnotes-local-first/")} class="card-base p-5 group active:scale-[0.99]">
				<div class="flex items-center gap-2 text-xs font-bold text-50 mb-3">
					<Icon name="fa6-solid:book-open" class="text-[var(--primary)]"></Icon>
					项目取舍
				</div>
				<h3 class="text-base font-bold text-90 group-hover:text-[var(--primary)] mb-2">
					MindNotes Pro 的本地优先取舍
				</h3>
				<p class="text-sm text-75 leading-6">
					关于更小的依赖面、本地数据边界、归因原则和长期维护重点。
				</p>
			</a>
			<a
				href="https://github.com/11suixing11/11suixing11"
				target="_blank"
				class="card-base p-5 group active:scale-[0.99]"
			>
				<div class="flex items-center gap-2 text-xs font-bold text-50 mb-3">
					<Icon name="fa6-solid:book-open" class="text-[var(--primary)]"></Icon>
					持续更新
				</div>
				<h3 class="text-base font-bold text-90 group-hover:text-[var(--primary)] mb-2">
					在 GitHub 查看维护记录
				</h3>
				<p class="text-sm text-75 leading-6">
					后续会继续整理 review follow-up、Canvas 输入问题、测试债务，以及因维护者反馈而改变的决策。
				</p>
			</a>
		</div>
	</div>
</section>
