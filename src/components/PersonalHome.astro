---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import avatar from "../assets/images/github-avatar.png";
import { ownerConfig } from "../config";
import type { PostForList } from "../utils/content-utils";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getPostUrlBySlug, url } from "../utils/url-utils";
import ProjectCards from "./ProjectCards.astro";
import ProjectOrbit from "./ProjectOrbit.astro";

interface Props {
	posts: PostForList[];
}

const { posts } = Astro.props;
---

<section class="home-hero" aria-labelledby="home-title">
	<div class="site-shell hero-shell">
		<div class="hero-intro">
			<a class="hero-profile" href={ownerConfig.githubUrl} rel="me" aria-label={`在 GitHub 查看 @${ownerConfig.handle}`}>
				<Image src={avatar} width={48} height={48} alt="" />
				<span>@{ownerConfig.handle}</span>
				<Icon name="fa6-solid:arrow-up-right-from-square" aria-hidden="true" />
			</a>
			<h1 id="home-title">{ownerConfig.name} 的<span>工程笔记</span></h1>
			<p>我做本地学习工具、浏览器白板和在线评测。这里写实现过程，也记录开源修复。</p>
			<div class="hero-actions">
				<a class="hero-button" href={url("/projects/")}>
					浏览项目 <Icon name="fa6-solid:arrow-right" aria-hidden="true" />
				</a>
				<a class="hero-button hero-button-outline" href={url("/archive/")}>阅读文章</a>
			</div>
		</div>
		<ProjectOrbit />
		<a class="scroll-link" href="#projects">
			<span class="scroll-arrow"><Icon name="fa6-solid:arrow-down" aria-hidden="true" /></span>
			<span>首页精选</span>
		</a>
	</div>
</section>

<div class="site-shell home-content">
	<section id="projects" class="site-section" aria-labelledby="featured-projects-title">
		<div class="site-section-heading">
			<div>
				<p class="section-index" aria-hidden="true">01 / PROJECTS</p>
				<h2 id="featured-projects-title">精选项目</h2>
			</div>
			<a class="site-text-link" href={url("/projects/")}>
				查看全部项目 <Icon name="fa6-solid:arrow-right" aria-hidden="true" />
			</a>
		</div>
		<ProjectCards />
	</section>

	<section id="notes" class="site-section" aria-labelledby="notes-title">
		<div class="site-section-heading">
			<div>
				<p class="section-index" aria-hidden="true">02 / NOTES</p>
				<h2 id="notes-title">最近发布</h2>
			</div>
			<a class="site-text-link" href={url("/archive/")}>
				文章归档 <Icon name="fa6-solid:arrow-right" aria-hidden="true" />
			</a>
		</div>
		<ul class="notes-list">
			{posts.slice(0, 4).map(({ slug, data }) => (
				<li>
					<a class="note-link" href={getPostUrlBySlug(slug)}>
						<time datetime={formatDateToYYYYMMDD(data.published)}>{formatDateToYYYYMMDD(data.published)}</time>
						<div>
							<h3>{data.title}</h3>
							{data.description && <p>{data.description}</p>}
						</div>
						<Icon class="note-arrow" name="fa6-solid:arrow-right" aria-hidden="true" />
					</a>
				</li>
			))}
		</ul>
	</section>
</div>

<style>
	.home-hero {
		position: relative;
		isolation: isolate;
		overflow: clip;
		background: radial-gradient(ellipse at 78% 52%, #21113c 0%, #120c26 37%, transparent 68%), var(--launch-bg);
		color: var(--launch-ink);
	}

	.home-hero::before {
		position: absolute;
		inset: 0;
		z-index: -1;
		content: "";
		background-image: radial-gradient(circle, #ad90e86f 0.65px, transparent 1px);
		background-size: 30px 30px;
		mask-image: linear-gradient(104deg, transparent 21%, black 76%, transparent);
		opacity: .3;
		pointer-events: none;
	}

	.hero-shell {
		display: grid;
		grid-template-columns: minmax(0, .81fr) minmax(0, 1.19fr);
		align-items: center;
		column-gap: clamp(1.5rem, 4vw, 4rem);
		row-gap: clamp(1.5rem, 3.6vw, 2.75rem);
		padding-block: clamp(2.6rem, 5.8vw, 5.25rem) 1.2rem;
	}

	.hero-profile {
		display: inline-flex;
		align-items: center;
		gap: .58rem;
		min-height: 2.75rem;
		padding: .35rem .75rem .35rem .35rem;
		border: 1px solid #584475;
		border-radius: 999px;
		background: #1a112b;
		color: #ded0f7;
		font: .84rem var(--site-mono);
	}
	.hero-profile:hover { background: #291a43; color: #fffaff; }
	.hero-profile img { width: 1.75rem; height: 1.75rem; border-radius: 50%; }
	.hero-profile svg { font-size: .67rem; margin-inline-start: .2rem; }

	.home-hero h1 {
		margin: clamp(1.35rem, 3vw, 2.2rem) 0 1.2rem;
		font-size: clamp(3rem, 6.45vw, 6.25rem);
		font-weight: 800;
		letter-spacing: -.058em;
		line-height: 1.01;
	}
	.home-hero h1 span {
		display: block;
		width: fit-content;
		margin-top: .12em;
		padding-block-end: .06em;
		color: #b98fff;
		background: linear-gradient(108deg, #dcc3ff -6%, #ac7aff 72%, #a87afa);
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero-intro p { max-width: 26rem; color: var(--launch-muted); font-size: clamp(1rem, 1.55vw, 1.125rem); line-height: 1.8; }
	.hero-actions { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: clamp(1.45rem, 3vw, 2rem); }
	.hero-button {
		display: inline-flex;
		align-items: center;
		gap: .65rem;
		min-height: 3rem;
		padding: .55rem 1.1rem;
		border: 1px solid #dbc2ff;
		border-radius: 999px;
		background: #c9a6ff;
		color: #20113b;
		font-size: .95rem;
		font-weight: 700;
	}
	.hero-button:hover { background: #e1cbff; border-color: #f0e2ff; }
	.hero-button svg { font-size: .8rem; }
	.hero-button-outline { background: #120d20; border-color: #65547e; color: #f3ecff; }
	.hero-button-outline:hover { background: #2c2041; border-color: #a680e4; }
	.home-hero a:focus-visible { outline-color: #d2b2ff; }

	.scroll-link {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		gap: .6rem;
		min-height: 3rem;
		padding-top: .7rem;
		border-top: 1px solid #aa8bc43e;
		color: var(--launch-muted);
		font-size: .83rem;
		letter-spacing: .07em;
	}
	.scroll-link:hover { color: var(--launch-ink); }
	.scroll-arrow { display: grid; place-items: center; width: 1.55rem; height: 1.55rem; border: 1px solid #786097; border-radius: 50%; color: #d9bfff; font-size: .66rem; }

	.home-content { padding-top: clamp(2.15rem, 5.2vw, 4.25rem); }
	.section-index { color: var(--primary); font: .72rem/1.25 var(--site-mono); letter-spacing: .1em; margin-bottom: .45rem; }
	.notes-list { border-top: 1px solid var(--site-border); }

	.note-link {
		display: grid;
		grid-template-columns: 8rem minmax(0, 1fr) auto;
		align-items: start;
		gap: 1rem;
		padding: 1.1rem .75rem;
		border-bottom: 1px solid var(--site-border);
		border-radius: .35rem;
	}
	.note-link:hover { background: var(--site-hover); }
	.note-link:hover h3 { color: var(--primary); }
	.note-link time { padding-top: .23rem; color: var(--site-muted); font: .85rem/1.2 var(--site-mono); }
	.note-link h3 { font-size: clamp(1rem, 2vw, 1.2rem); font-weight: 700; line-height: 1.5; }
	.note-link p { color: var(--site-muted); margin-top: .25rem; font-size: .9rem; line-height: 1.65; }
	.note-arrow { color: var(--primary); width: .85rem; margin-top: .35rem; }

	@media (prefers-reduced-motion: no-preference) {
		.hero-intro { animation: intro-in .6s cubic-bezier(.2,.68,.25,1) both; }
		@keyframes intro-in { from { opacity: .45; transform: translateY(.55rem); } to { opacity: 1; transform: none; } }
		.note-arrow { transition: transform .22s ease-out; }
		.note-link:hover .note-arrow { transform: translateX(.2rem); }
	}
	@media (forced-colors: active) {
		.home-hero h1 span { background: none; color: CanvasText; -webkit-text-fill-color: currentColor; }
	}
	@media (max-width: 760px) {
		.home-hero { background: radial-gradient(ellipse at 70% 57%, #241343, transparent 64%), var(--launch-bg); }
		.hero-shell { grid-template-columns: minmax(0, 1fr); padding-top: clamp(2rem, 7vw, 3.35rem); row-gap: 1.85rem; }
		.home-hero h1 { font-size: clamp(3rem, 11vw, 5rem); margin-bottom: 1rem; }
		.hero-intro p { max-width: 29rem; }
	}

	@media (max-width: 590px) {
		.note-link { grid-template-columns: minmax(0, 1fr) auto; gap: .35rem .75rem; padding-inline: .35rem; }
		.note-link time { grid-column: 1 / -1; padding-top: 0; font-size: .78rem; }
	}
</style>
