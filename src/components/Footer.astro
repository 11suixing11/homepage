---
import { ownerConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
---

<footer class="site-shell site-footer" data-pagefind-ignore>
	<div>
		<p>&copy; {currentYear} {ownerConfig.name}</p>
		<p class="footer-credit">基于 <a href="https://astro.build">Astro</a> 与 <a href="https://github.com/saicaca/fuwari">Fuwari</a></p>
	</div>
	<nav aria-label="页脚导航">
		<a href={ownerConfig.githubUrl} rel="me">GitHub</a>
		<a href={url("rss.xml")} data-no-swup>RSS</a>
		<a href={url("sitemap-index.xml")} data-no-swup>Sitemap</a>
	</nav>
</footer>

<style>
	.site-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.85rem 2rem;
		margin-top: clamp(2.75rem, 6vw, 5rem);
		padding: 1.5rem 0 2rem;
		border-top: 1px solid var(--site-border);
		color: var(--site-muted);
		font-size: 0.875rem;
	}
	.footer-credit { margin-top: 0.3rem; font-size: 0.8rem; }
	.site-footer nav { display: flex; flex-wrap: wrap; gap: 0.6rem 1.2rem; }
	.site-footer a:hover { color: var(--primary); text-decoration: underline; text-underline-offset: 0.25em; }
</style>
