---
import { Icon } from "astro-icon/components";
import { navBarConfig, ownerConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { pathsEqual, url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";

const links = navBarConfig.links
	.map((link) => typeof link === "number" ? LinkPresets[link] : link)
	.filter((link) => !link.external);
---

<header class="site-header" data-pagefind-ignore>
	<div class="site-shell site-navbar">
		<a class="site-brand" href={url("/")} data-no-swup aria-label={`${siteConfig.title}首页`}>
			<span class="brand-icon"><Icon name="fa6-solid:code" aria-hidden="true" /></span>
			<span>{ownerConfig.name}<span class="brand-period" aria-hidden="true">.</span></span>
		</a>

		<nav class="site-nav" aria-label="主导航">
			{links.map((link) => (
				<a data-site-nav href={url(link.url)} data-no-swup={pathsEqual(link.url, "/") ? true : undefined} aria-current={pathsEqual(Astro.url.pathname, url(link.url)) ? "page" : undefined}>
					{link.name}
				</a>
			))}
		</nav>

		<div class="site-toolbar">
			<Search client:load label="站内搜索">
				<Icon slot="searchIcon" name="material-symbols:search-rounded" aria-hidden="true" />
				<Icon slot="closeIcon" name="material-symbols:close-rounded" aria-hidden="true" />
			</Search>
			<LightDarkSwitch client:load label="切换配色" />
			{!siteConfig.themeColor.fixed && (
				<>
					<button class="btn-plain toolbar-button" type="button" aria-label="主题颜色" aria-expanded="false" aria-controls="display-setting" id="display-settings-switch">
						<Icon name="material-symbols:palette-outline" aria-hidden="true" />
					</button>
					<DisplaySettings client:only="svelte" />
				</>
			)}
			<a class="toolbar-github" href={ownerConfig.githubUrl} rel="me" aria-label="GitHub">
				<Icon name="fa6-brands:github" aria-hidden="true" />
				<span>GitHub</span>
			</a>
		</div>
	</div>
</header>

<style>
	.site-header { position: relative; z-index: 30; border-bottom: 1px solid var(--site-border); }
	.site-navbar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 4.55rem; gap: 0.85rem; }
	.site-brand { display: inline-flex; justify-self: start; align-items: center; gap: 0.62rem; font-size: 1.55rem; line-height: 1; font-weight: 700; letter-spacing: -0.06em; }
	.brand-icon { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: .625rem; background: #29203e; border: 1px solid #665084; color: #ebd5ff; font-size: .85rem; }
	.brand-period { color: var(--primary); }
	.site-nav { display: flex; justify-content: center; gap: 0.25rem; }
	.site-nav a { display: flex; justify-content: center; align-items: center; min-height: 2.65rem; padding-inline: clamp(0.65rem, 1.3vw, 1.15rem); border-radius: 0.55rem; color: var(--site-muted); font-size: 0.9375rem; font-weight: 700; white-space: nowrap; }
	.site-nav a:hover, .site-nav a[aria-current="page"] { background: var(--site-hover); color: var(--primary); }
	.site-toolbar { display: flex; justify-content: end; align-items: center; gap: 0.15rem; }
	.toolbar-button, .toolbar-github { display: inline-flex; align-items: center; justify-content: center; min-width: 2.75rem; height: 2.75rem; border-radius: 0.55rem; }
	.toolbar-button { font-size: 1.2rem; }
	.toolbar-github { gap: 0.45rem; color: var(--site-ink); font-size: 0.875rem; font-weight: 700; padding: 0 0.55rem; white-space: nowrap; }
	.toolbar-github:hover { background: var(--site-hover); color: var(--primary); }
	.toolbar-github svg { font-size: 1.12rem; }

	@media (max-width: 840px) { .toolbar-github span { display: none; } }
	@media (max-width: 620px) {
		.site-navbar { grid-template-columns: 1fr auto; gap: 0.25rem 0.35rem; padding: 0.65rem 0 0.5rem; }
		.site-nav { grid-column: 1 / -1; grid-row: 2; justify-content: start; }
		.site-nav a { flex: 1; min-height: 2.6rem; }
	}
</style>

<script>
	import { pathsEqual } from "../utils/url-utils";

	function updateNavigation() {
		for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-site-nav]")) {
			if (pathsEqual(link.pathname, window.location.pathname)) link.setAttribute("aria-current", "page");
			else link.removeAttribute("aria-current");
		}
	}
	document.addEventListener("swup:page:view", updateNavigation);

	const displaySwitch = document.querySelector<HTMLButtonElement>("#display-settings-switch");
	if (displaySwitch) {
		function setDisplayPanel(open: boolean) {
			const panel = document.getElementById("display-setting");
			if (!panel) return;
			panel.classList.toggle("float-panel-closed", !open);
			displaySwitch?.setAttribute("aria-expanded", String(open));
		}

		displaySwitch.addEventListener("click", () => {
			setDisplayPanel(displaySwitch.getAttribute("aria-expanded") !== "true");
		});
		document.addEventListener("click", (event) => {
			const target = event.target;
			if (target instanceof Node && !displaySwitch.contains(target) && !document.getElementById("display-setting")?.contains(target)) {
				setDisplayPanel(false);
			}
		});
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && displaySwitch.getAttribute("aria-expanded") === "true") {
				setDisplayPanel(false);
				displaySwitch.focus();
			}
		});
	}
</script>
